pca_biplot(pca_result, label = "var", col.var = "blue", col.ind = "red")
# Biplot to examine the relationship between variables and principal components
plot(pca_result, label = "var", col.var = "blue", col.ind = "red")
# 4. Visualizing PCA with ggplot2
# Create a data frame with PCA scores and species information
pca_scores <- data.frame(pca_result$x, SpeciesID = tree_VI$SpeciesID)
View(pca_scores)
# PCA plot with species ID as colors
ggplot(pca_scores, aes(x = PC1, y = PC2, color = SpeciesID)) +
geom_point() +
theme_minimal() +
labs(title = "PCA of Vegetation Indices by Species", x = "Principal Component 1", y = "Principal Component 2") +
theme(legend.position = "right")
# Read in Vegetation indices calculation
tree_VI <- read.csv("C:/Users/PaintRock/Documents/Data processing/Hyperspectral/Vegindex_calc.csv")
tree_VI <- tree_VI[,-1]  # Remove first column (if it's not needed)
tree_VI <- tree_VI[,-4]  # Remove unnecessary column
tree_VI <- tree_VI[,-7]  # Remove unnecessary column
# Define a list of SpeciesID values to remove
species_to_remove <- c("LITU", "DIVI5", "AEFL", "FAGR", "JUNI", "LIST2", "QUNI", "QUSH")
tree_VI <- tree_VI %>%
dplyr::filter(!SpeciesID %in% species_to_remove)
str(tree_VI)
# Creating a balanced sample by sampling the same number of observations per species
tree_VI <- tree_VI %>%
group_by(SpeciesID) %>%
sample_n(150)
# Data preparation: removing unnecessary columns (Group, SpeciesID, TreeID)
data <- tree_VI %>%
dplyr::select(-Group, -SpeciesID, -TreeID)  # Remove non-numeric columns for distance calculation
# 1. Correlation analysis between TreeID and numerical columns
# Calculate the correlation between numerical columns and TreeID, grouped by SpeciesID
cor_data <- tree_VI %>%
group_by(SpeciesID) %>%  # Group by SpeciesID
summarise(across(where(is.numeric), ~cor(.x, TreeID, use = "complete.obs"), .names = "cor_{col}"))
# Display the correlation results
print(cor_data)
View(tree_VI)
View(data)
View(cor_data)
# 2. ANOVA with Adonis2 using TreeID as the grouping factor
# Select only numeric columns from 'data'
numeric_data <- data[,-1]
# Creating a dissimilarity matrix (e.g., using Euclidean distance)
dist_matrix <- vegdist(numeric_data, method = "euclidean")
# Conduct the Adonis2 test to examine the relationship between TreeID and vegetation indices
adonis_result <- adonis2(dist_matrix ~ TreeID, data = tree_VI, permutations = 100)
View(adonis_result)
# 3. PCA (Principal Component Analysis)
# Perform PCA on the numeric vegetation indices
pca_result <- prcomp(numeric_data, scale. = TRUE)
# 4. Visualizing PCA with ggplot2
# Create a data frame with PCA scores and species information
pca_scores <- data.frame(pca_result$x, SpeciesID = tree_VI$SpeciesID)
View(pca_scores)
# Plot PCA using ggplot2 (example)
ggplot(pca_scores, aes(x = PC1, y = PC2, color = SpeciesID)) +
geom_point() +
theme_minimal() +
labs(title = "PCA of Vegetation Indices", x = "Principal Component 1", y = "Principal Component 2")
